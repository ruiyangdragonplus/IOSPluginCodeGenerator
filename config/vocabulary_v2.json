    "codeBlock": {
      "log": [
        "NSLog(@\"[DEBUG] %@ called\", NSStringFromSelector(_cmd));",
        "os_log(OS_LOG_DEFAULT, \"[INFO] %{public}s\", __func__);",
        "NSLog(@\"[VERBOSE] Value: %@\", value);",
        "os_log_type_enabled(OS_LOG_DEFAULT, OS_LOG_TYPE_DEBUG)",
        "NSAssert(value != nil, @\"Value must not be nil\");",
        "NSParameterAssert(param != nil);",
        "NSCParameterAssert(param != nil);",
        "os_signpost(.begin, log: .default, name: \"%{public}s\", __func__);"
      ],
      "validation": [
        "if (value == nil) { return NO; }",
        "NSParameterAssert(param != nil);",
        "if (![value isKindOfClass:[NSString class]]) { return NO; }",
        "if (value.length == 0) { return NO; }",
        "if (count > maxCount) { return NO; }",
        "if (index < 0 || index >= array.count) { return NO; }",
        "NSAssert(self != nil, @\"Self must not be nil\");",
        "if (!self) { return nil; }"
      ],
      "nullCheck": [
        "if (value == nil) { return; }",
        "if (object == nil) { return NO; }",
        "NSParameterAssert(object != nil);",
        "if (!self) { return; }",
        "guard let value = value else { return };",
        "if (ptr == NULL) { return; }",
        "if (!ptr) { return; }",
        "NSAssert(ptr != NULL, @\"Pointer must not be NULL\");"
      ],
      "errorHandling": [
        "NSError *error = nil;",
        "@try { } @catch (NSException *exception) { NSLog(@\"Exception: %@\", exception); }",
        "if (error) { *error = [NSError errorWithDomain:@\"com.error\" code:-1 userInfo:nil]; return NO; }",
        "dispatch_async(dispatch_get_main_queue(), ^{ completionHandler(nil, error); });",
        "@throw [NSException exceptionWithName:@\"InvalidState\" reason:@\"Invalid state\" userInfo:nil];",
        "if (!success) { return [self handleError:error]; }",
        "NSError * __autoreleasing *errorPtr = &error;",
        "return [self processError:error];"
      ],
      "async": [
        "dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{ });",
        "dispatch_async(dispatch_get_main_queue(), ^{ });",
        "[self performSelector:@selector(method) withObject:nil afterDelay:0.5];",
        "NSOperationQueue *queue = [[NSOperationQueue alloc] init];",
        "dispatch_group_async(group, queue, ^{ });",
        "dispatch_semaphore_wait(semaphore, DISPATCH_TIME_FOREVER);",
        "dispatch_semaphore_signal(semaphore);",
        "[NSThread detachNewThreadSelector:@selector(method) toTarget:self withObject:nil];"
      ],
      "cache": [
        "NSString *key = [NSString stringWithFormat:@\"%@_%@\", NSStringFromClass([self class]), identifier];",
        "id cached = [self.cache objectForKey:key];",
        "[self.cache setObject:object forKey:key];",
        "[self.cache removeObjectForKey:key];",
        "if (cached) { return cached; }",
        "NSString *cacheKey = [self cacheKeyForIdentifier:identifier];",
        "[self.memoryCache setObject:obj forKey:key cost:cost];",
        "id obj = [self.diskCache objectForKey:key];"
      ],
      "loop": [
        "for (int i = 0; i < count; i++) { }",
        "for (id obj in array) { }",
        "[array enumerateObjectsUsingBlock:^(id obj, NSUInteger idx, BOOL *stop) { }];",
        "for (NSUInteger i = 0; i < array.count; i++) { id obj = array[i]; }",
        "NSEnumerator *enumerator = [array objectEnumerator]; id obj; while ((obj = [enumerator nextObject])) { }",
        "for (NSDictionary *item in items) { }",
        "for (NSString *key in dictionary) { id value = dictionary[key]; }",
        "while (condition) { }"
      ],
      "condition": [
        "if (condition) { } else { }",
        "switch (state) { case StateA: break; default: break; }",
        "if ([value isKindOfClass:[NSString class]]) { }",
        "if (value != nil && [value respondsToSelector:@selector(method)]) { }",
        "if (flag && enabled) { }",
        "if (count > 0 && count <= maxCount) { }",
        "if (self.delegate && [self.delegate respondsToSelector:@selector(method)]) { }",
        "switch (type) { case TypeA: return @\"A\"; case TypeB: return @\"B\"; default: return @\"Unknown\"; }"
      ]
    }
